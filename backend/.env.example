# ---- Server ----
NODE_ENV=development
PORT=8080
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=7d

# ---- Database / Redis ----
DATABASE_URL=postgresql://expense:expense_dev_pw@localhost:5438/expense_tracker
REDIS_URL=redis://localhost:6380

# Oracle secret: 32+ char string used to encrypt git_access_token & OAuth tokens.
ENCRYPTION_KEY=

# ---- Email driver: agentmail | gmail ----
EMAIL_SERVICE_PROVIDER=agentmail
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=            # sending inbox, e.g. myorg@agentmail.to
AGENTMAIL_TO=               # default recipient for product emails
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ---- Google Drive upload (Bearer OAuth access token) ----
GOOGLE_DRIVE_ACCESS_TOKEN=

# ---- Stripe (mock mode uses STRIPE_MOCK=true, no real keys needed) ----
STRIPE_MOCK=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_starter_250
STRIPE_PRICE_PRO=price_pro_500

# ---- Git integration (GitHub OAuth for auto-sync) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/api/git/oauth/callback

# ---- Tenant API key for n8n OCR webhook ingestion ----
TENANT_API_KEY_DEFAULT=dev-tenant-key-0000

# ---- Storage mode default ----
DEFAULT_STORAGE_MODE=normal

# ---- Quota defaults (receipts / month) ----
FREE_RECEIPT_LIMIT=20
STARTER_RECEIPT_LIMIT=100
PRO_RECEIPT_LIMIT=300